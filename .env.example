# OpenCode Zen / DeepSeek V4 Flash
# Create/retrieve your opencode API key, then set OPENAI_API_KEY to it.
# Zen sells at cost: $0.14/M in, $0.28/M out.
OPENAI_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=deepseek-v4-flash

# Web search
TAVILY_API_KEY=

# Loop guard / budget caps
MAX_ITERATIONS=3
PER_REQUEST_BUDGET=0.05

# Optional observability (leave blank to skip)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: search tuning
SEARCH_DEPTH=basic
MAX_SEARCH_RESULTS=5